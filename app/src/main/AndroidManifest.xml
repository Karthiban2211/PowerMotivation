<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".PowerMotivationApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_media_play"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_media_play"
        android:supportsRtl="true"
        android:theme="@style/Theme.PowerMotivation"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lock Screen Widget Activity (NEVER turns screen on by itself; only shows when user wakes screen) -->
        <activity
            android:name=".ui.WidgetPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:taskAffinity=""
            android:theme="@style/Theme.PowerMotivation.FloatingWidget" />

        <receiver
            android:name=".widget.SmallMotivationWidgetProvider"
            android:exported="true"
            android:label="@string/widget_small_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.karthiban.powermotivation.ACTION_WIDGET_MUTE_TOGGLE" />
                <action android:name="com.karthiban.powermotivation.ACTION_WIDGET_OPEN_PLAYER" />
                <action android:name="com.karthiban.powermotivation.ACTION_REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_small" />
        </receiver>

        <receiver
            android:name=".widget.LargeMotivationWidgetProvider"
            android:exported="true"
            android:label="@string/widget_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.karthiban.powermotivation.ACTION_WIDGET_MUTE_TOGGLE" />
                <action android:name="com.karthiban.powermotivation.ACTION_WIDGET_OPEN_PLAYER" />
                <action android:name="com.karthiban.powermotivation.ACTION_REFRESH_WIDGETS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_large" />
        </receiver>

        <service
            android:name=".widget.MotivationWidgetRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Live Wallpaper Widget Box Engine (Renders a clean Widget Box on Home & Lock Screen only) -->
        <service
            android:name=".lockscreen.MotivationWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/wallpaper_service_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper_info" />
        </service>

        <!-- Home-Only & Lock-Only Widget Service -->
        <service
            android:name=".lockscreen.LockScreenKeyguardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Instant Home-Screen Detector so widget NEVER shows over other apps -->
        <service
            android:name=".lockscreen.HomeScreenDetectorService"
            android:enabled="true"
            android:exported="true"
            android:label="Power Motivation Home Screen Detector"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_home_detector" />
        </service>

        <receiver
            android:name=".lockscreen.BootRestartReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>