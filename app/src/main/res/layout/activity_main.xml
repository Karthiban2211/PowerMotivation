<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121216"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Power Motivation"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Pure Normal Home Screen Widget &amp; Lock Screen Player (Zero Overlays)"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_add_media"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+ Add Photos / Videos"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_refresh_normal_widget"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Sync Home Widget"
                android:textAllCaps="false"
                android:textColor="#80CBC4" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_library_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Playlist (0 items — Drag to reorder)"
            android:textColor="#E0E0E0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_media_library"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#18181F"
            android:padding="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1B1B22"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Normal Home Screen Widget Settings"
                    android:textColor="#80CBC4"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_home_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Enable Home Screen Widget"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_home_autoplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Video Autoplay inside Widget"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_home_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Sound Enabled by Default (Home Screen)"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_home_loop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Loop Current Video"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Home Widget Media Fitting:"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_home_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_home_crop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Center Crop (Fill)"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rb_home_fit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Fit to Screen"
                        android:textColor="#FFFFFF" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1B1B22"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lock Screen Settings (Independent)"
                    android:textColor="#FFB74D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_lock_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Enable Lock Screen Experience"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_lock_autoplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Lock Screen Video Autoplay"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_lock_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Sound Enabled by Default (Lock Screen)"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_lock_loop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Loop Lock Screen Video"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Lock Screen Media Fitting:"
                    android:textColor="#BDBDBD"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rg_lock_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_lock_crop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Center Crop (Fill)"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rb_lock_fit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Fit to Screen"
                        android:textColor="#FFFFFF" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_activate_lock_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Activate Lock Screen Player (Live Wallpaper)"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>