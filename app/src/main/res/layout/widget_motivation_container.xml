<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_rounded">

    <!-- Single Direct Media Display inside Normal Home Screen Widget (NO list, NO stack) -->
    <ImageView
        android:id="@+id/widget_media_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <!-- Invisible Left/Right Touch Zones to switch items directly inside the widget without opening any popup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <FrameLayout
            android:id="@+id/widget_touch_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_touch_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Shown only when playlist is empty -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_empty_prompt"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- The ONLY visible button over the media: Small Volume Icon -->
    <ImageView
        android:id="@+id/widget_volume_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_volume_pill"
        android:contentDescription="@string/cd_volume_toggle"
        android:padding="6dp"
        android:src="@drawable/ic_volume_off" />

</FrameLayout>